# MiniDocs 部署参数
#
# 用法：cp .env.example .env 后逐项填写，然后 chmod 600 .env。
# .env 里全是明文口令，已在 .gitignore 与 .dockerignore 中排除，不要提交。
#
# 生成强随机值：
#   密码     openssl rand -base64 18
#   JWT 密钥 openssl rand -base64 48      # 必须 >= 32 字节，一经更换所有已签发 token 立即失效

# ---------------------------------------------------------------- 镜像
# 两个镜像由仓库根的 Dockerfile 分 target 构建：
#   docker build --target app -t minidocs:1.2.0 .
#   docker build --target web -t minidocs-web:1.2.0 .
IMAGE_TAG=minidocs:1.2.0
WEB_IMAGE_TAG=minidocs-web:1.2.0

# ---------------------------------------------------------------- 对外入口
# 宿主机映射的端口。前面挂了宿主机自己的 Nginx / 宝塔 / 面板时改成 8080 之类，避免抢 80
WEB_PORT=80

# 站点基址：分享链接、复制链接等一切对外地址的基址，务必与浏览器地址栏里看到的完全一致。
# 注意优先在「站点设置」页（/console/platform/site）里配，改完即生效、不必重启；
# 本项只是部署期兜底，两处别填成两个不同地址。
# 已上 HTTPS 就写 https://——写成 http:// 会让复制出去的分享链接降级。
PAGE_BASE_URL=http://docs.minims.cn

# ---------------------------------------------------------------- 数据库
MYSQL_DATABASE=minidocs
MYSQL_USER=minidocs
MYSQL_PASSWORD=改成强密码
MYSQL_ROOT_PASSWORD=改成另一个强密码

# ---------------------------------------------------------------- 应用
# 首次登录用，仅初始化时生效：登录后立刻在控制台改一次密码
ADMIN_USER=admin
ADMIN_PASS=改成强密码

JWT_SECRET=至少32字节的随机串

# 对外网部署建议 false：注册入口关闭后由管理员建号
REGISTER_ENABLED=false

# 分享口令通过后的免密时长（小时）
SHARE_COOKIE_HOURS=12

LOG_LEVEL=info

# ---- 接口文档 ----
# prod 默认关闭：/minidocs/swagger-ui 与 /minidocs/v3/api-docs 公开可访问，
# 等于把全部接口形状、参数与错误码摊给访客。排障时临时置 true，重启后生效。
SWAGGER_ENABLED=false

# ---------------------------------------------------------------- 内存
# JVM 堆 = APP_MEMORY_LIMIT × 0.75（Dockerfile 里 MaxRAMPercentage=75）。
# 机器 2G：app 1g + db 640m + web 128m；机器 4G：可把 APP_MEMORY_LIMIT 提到 2g。
# 判断依据：free -m 里 available 至少要等于三者之和再加 512M 余量。
APP_MEMORY_LIMIT=1g
DB_MEMORY_LIMIT=640m

# ---------------------------------------------------------------- 可选：排障时打开
# Druid 池监控页。默认 allow 只放行 127.0.0.1，容器内远程访问要看下面的 DRUID_MONITOR_ALLOW
# DRUID_MONITOR_ENABLED=true
# DRUID_MONITOR_USER=admin
# DRUID_MONITOR_PASSWORD=改成强密码
