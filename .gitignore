# IDE
/.idea/
*.iml

# 本地开发数据（VAULT_HOME：SQLite 数据库、知识库目录、日志）
/data/
/backend/data/
*.db
*.db-shm
*.db-wal

# 后端构建产物
/backend/target/

# 前端依赖与临时日志
/front/node_modules/
/front/*.log
/front/*.log.err
/front/*.txt

# 前端构建产物：front/dist 交给静态服务器伺服在站点根，不入库
/front/dist/

# 本地验证用的 vault 副本、启动日志与临时 token —— 里面有真实数据，绝不入库
/.verify/

# 前端构建产物：front/ 构建时直接写入后端 resources（admin/ + user/），随 jar 分发，不入库
/backend/src/main/resources/static/

