# IDE
/.idea/
*.iml

# 本地开发数据（VAULT_HOME：SQLite 数据库、知识库目录、日志）
/data/
/backend/data/
*.db
*.db-shm
*.db-wal

# 后端构建产物
/backend/target/

# 前端依赖与临时日志
/front/node_modules/
/front/*.log
/front/*.log.err
/front/*.txt
# vite 插件（svg symbol 注入）每次构建都会写这个 err 日志
/front/*.err

# npm 私有源配置：内含明文 _authToken（阿里云效 / npmjs），绝不入库
**/.npmrc

# 前端构建产物：front/dist 交给静态服务器伺服在站点根，不入库
/front/dist/

# 本地验证用的 vault 副本、启动日志与临时 token —— 里面有真实数据，绝不入库
/.verify/

# 前端构建产物：front/ 构建时直接写入后端 resources（admin/ + user/），随 jar 分发，不入库
/backend/src/main/resources/static/

# 操作系统
.DS_Store
Thumbs.db
/.workbuddy/
/.vscode/

# 容器部署：.env 是明文口令，data/ 是数据卷挂载点（文档、头像、日志、SQLite）
/deploy/.env
/deploy/data/
minidocs-src.tar.gz
